DATABASE_URL="postgresql://USER@localhost:5432/knowledge_loop?schema=public"
DASHBOARD_PASSWORD="changeme"
AUTH_SECRET="generate-with-openssl-rand-hex-32"
INGEST_TOKEN=""

# Writes the interpretive copy. Leave blank to ship the deterministic copy instead.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.6-terra"

# Iframe embedding — comma-separated list of origins allowed to embed this app.
# Example: "https://portal.rightanswers.com,https://qa-develop.rightanswers.com"
# Leave blank to block all cross-origin iframe embedding (default).
EMBED_FRAME_ANCESTORS=""

# Lifetime of embed tokens in days (default: 7).
EMBED_TOKEN_MAX_AGE_DAYS=7
